{
  "name": "mita-time",
  "version": "0.1.0",
  "description": "現代極簡番茄鐘 - Dark Glassmorphism Pomodoro Timer",
  "main": "dist/main/main.js",
  "author": "MitaTime",
  "license": "MIT",
  "private": true,
  "scripts": {
    "generate-icon": "node scripts/generate-icon.js",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "pnpm generate-icon && pnpm build:main && pnpm build:renderer",
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:5173 && cross-env NODE_ENV=development electron .",
    "dev": "pnpm generate-icon && pnpm build:main && concurrently -k -n vite,electron -c blue,magenta \"pnpm dev:vite\" \"pnpm dev:electron\"",
    "start": "pnpm build && electron .",
    "type-check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.main.json --noEmit",
    "package": "pnpm build && electron-builder --config electron-builder.yml"
  },
  "dependencies": {
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^26.8.1",
    "png-to-ico": "^3.0.1",
    "rcedit": "^5.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.34.5",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  }
}
